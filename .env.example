# 复制为 .env 并填写。.env 已被 gitignore，不会提交。

# --- 读（必填）---
# Google Sheet ID（URL 中 /d/ 与 /edit 之间那段）
SPREADSHEET_ID=
# 目标 tab 的 gid（URL 中 gid= 后面的数字）
GID=
# tab 名称（写回时用，须与表内 tab 名完全一致）
TAB=

# --- 表结构（0-based 列号，默认适配 KOl 表：A频道 D类别 E身份 F AI相关 J备注）---
# COL_HANDLE=0
# COL_CATEGORY=3
# COL_IDENTITY=4
# NOTE_COL=J

# --- 写回（仅 apply_edits --write 需要；问表格 owner 要，不要提交进 git）---
WEBHOOK_URL=
WEBHOOK_TOKEN=
